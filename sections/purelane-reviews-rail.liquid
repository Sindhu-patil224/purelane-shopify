{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

{%- comment -%}
  The prototype's marquee works by literally duplicating the card list once
  in the HTML and animating -50% translateX, so the loop is seamless. We
  reproduce that with a Liquid loop that renders the list twice rather than
  hand-duplicating markup, and mark the second copy aria-hidden so screen
  readers only ever hear the reviews once.
{%- endcomment -%}

<section
  id="PurelaneReviews-{{ section.id }}"
  class="pl-section pl-revband pl-scene-2"
  data-pl-section="reviews"
>
  <div class="pl-wrap">

    <div class="pl-revhead pl-rv">

      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">
          {{ section.settings.kicker }}
        </span>
      {%- endif -%}

      {%- if section.settings.rating != blank -%}

        <span class="pl-agg">

          <span class="pl-st" aria-hidden="true">

            {%- assign full_stars = section.settings.rating | round -%}

            {%- for i in (1..5) -%}
              {% if i <= full_stars %}★{% else %}☆{% endif %}
            {%- endfor -%}

          </span>

          <b>{{ section.settings.rating }}</b>
          from {{ section.settings.review_count }} reviews

        </span>

      {%- endif -%}

      {%- if section.settings.homes_text != blank -%}
        <span class="pl-agg">
          {{ section.settings.homes_text }}
        </span>
      {%- endif -%}

    </div>

  </div>

  {%- if section.blocks.size > 0 -%}

    <div
      class="pl-revrail pl-rv"
      aria-label="Customer reviews"
      role="region"
    >

      <div class="pl-revtrack">

        {%- for copy in (1..2) -%}

          {%- for block in section.blocks -%}

            <article
              class="pl-glass-2 pl-rcard"
              {% if copy == 1 %}
                {{ block.shopify_attributes }}
              {% else %}
                aria-hidden="true"
              {% endif %}
            >

              <div class="pl-st" aria-hidden="true">

                {%- for i in (1..5) -%}
                  {% if i <= block.settings.stars %}★{% else %}☆{% endif %}
                {%- endfor -%}

              </div>

              <h5>
                {{ block.settings.headline }}
              </h5>

              <p>
                {{ block.settings.quote }}
              </p>

              <div class="pl-who">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7"/>
                </svg>

                <b>
                  {{ block.settings.name }}
                </b>

                {%- if block.settings.product_label != blank -%}
                  <span>
                    · {{ block.settings.product_label }}
                  </span>
                {%- endif -%}

              </div>

            </article>

          {%- endfor -%}

        {%- endfor -%}

      </div>

    </div>

  {%- endif -%}

</section>

{% schema %}
{
  "name": "Purelane reviews rail",
  "tag": "section",
  "class": "pl-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "number",
      "id": "rating",
      "label": "Aggregate rating",
      "default": 4.8
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_text",
      "label": "Second stat (optional)",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product (optional)",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "headline": "Works like a charm",
            "quote": "Finally an eco option that cleans as well as the chemical detergent I used for years.",
            "name": "Anita",
            "product_label": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Best dishwash ever",
            "quote": "Our old dishwash left my hands dry and cracked. That stopped after we switched.",
            "name": "Priya",
            "product_label": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "headline": "Dog friendly",
            "quote": "We switched because chemical floor cleaners were setting off my dog's allergies.",
            "name": "Rohit S.",
            "product_label": "Floor cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}