{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

<section
  id="PurelaneShop-{{ section.id }}"
  class="pl-section pl-sec pl-scene-3"
  data-pl-section="shop"
>
  <div class="pl-wrap">

    <div class="pl-panel-head pl-rv">

      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">
          {{ section.settings.kicker }}
        </span>
      {%- endif -%}

      <h2 class="pl-d2" style="margin-top:12px">
        {{ section.settings.heading }}
      </h2>

      <div class="pl-rule">
        <i></i>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>
      </div>

    </div>

    {%- assign collection = collections[section.settings.collection] -%}

    <div
      class="pl-shelf"
      style="--pl-cols:{{ section.settings.columns_desktop }}"
    >

      {%- if collection != blank -%}

        {%- for product in collection.products limit: section.settings.products_to_show -%}

          {% render 'purelane-product-card',
            product: product,
            card_index: forloop.index0
          %}

        {%- else -%}

          <p>
            Add products to the "{{ collection.title }}" collection to fill this grid.
          </p>

        {%- endfor -%}

      {%- else -%}

        {%- comment -%}
          Editor placeholder before a collection is chosen
        {%- endcomment -%}

        {%- for i in (1..section.settings.products_to_show) -%}

          <article class="pl-glass pl-card pl-rv">

            <div class="pl-shot">
              <span class="pl-noimg" aria-hidden="true">
                {{ 'product-1' | placeholder_svg_tag }}
              </span>
            </div>

            <h4>
              Select a collection
            </h4>

            <div class="pl-pr">
              <strong>{{ 0 | money }}</strong>
            </div>

          </article>

        {%- endfor -%}

      {%- endif -%}

    </div>

    {%- if collection != blank and section.settings.show_view_all -%}

      <p style="text-align:center;margin-top:22px">

        <a
          class="pl-btn pl-btn-ghost"
          href="{{ collection.url }}"
        >
          View all

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h13m-5-6 6 6-6 6"/>
          </svg>

        </a>

      </p>

    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane shop grid",
  "tag": "section",
  "class": "pl-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Purelane shop grid"
    }
  ]
}
{% endschema %}