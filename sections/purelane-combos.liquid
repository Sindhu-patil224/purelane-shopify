{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

{%- comment -%}
  A "combo" here is a curated set of products sold together at a flat
  price. Shopify has no native bundle-with-its-own-price object without
  the Shopify Bundles app / a selling-plan setup, so this section solves
  it the way a lot of production Dawn builds do: the merchant picks the
  real products (so imagery/alt text/availability stay live) and types
  the bundle's actual selling price; the "compare at" and "you save"
  values are computed automatically from the chosen products' own prices.
{%- endcomment -%}

<section
  id="PurelaneCombos-{{ section.id }}"
  class="pl-section pl-sec pl-scene-3"
  data-pl-section="combos"
>
  <div class="pl-wrap">

    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      <h2 class="pl-d2" style="margin-top:12px">
        {{ section.settings.heading }}
      </h2>

      <div class="pl-rule">
        <i></i>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}
    </div>

    <div class="pl-comborail pl-rv">

      {%- for block in section.blocks -%}

        {%- liquid
          assign products = block.settings.products
          assign compare_total = 0

          for p in products
            assign line_compare = p.compare_at_price | default: p.price
            assign compare_total = compare_total | plus: line_compare
          endfor

          assign savings = compare_total | minus: block.settings.bundle_price
        -%}

        <article
          class="pl-glass pl-combo{% if block.settings.featured %} pl-hero-combo{% endif %}"
          {{ block.shopify_attributes }}
        >

          <div class="pl-tray">

            {%- if savings > 0 -%}
              <span class="pl-save">
                You save {{ savings | money }}
              </span>
            {%- endif -%}

            {%- if block.settings.flag != blank -%}
              <span class="pl-flag">
                {{ block.settings.flag }}
              </span>
            {%- endif -%}

            <div class="pl-stack">

              {%- for product in products limit: 3 -%}

                <span class="pl-it">

                  {%- if product.featured_media -%}

                    {{
                      product.featured_media
                      | image_url: width: 160
                      | image_tag:
                        loading: 'lazy',
                        alt: product.title
                    }}

                  {%- else -%}

                    <span class="pl-tile" aria-hidden="true">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </span>

                  {%- endif -%}

                  <span>{{ product.title }}</span>

                </span>

                {%- unless forloop.last -%}
                  <span class="pl-plus" aria-hidden="true">+</span>
                {%- endunless -%}

              {%- endfor -%}

            </div>
          </div>

          <div class="pl-body">

            <h3 class="pl-clamp2">
              {{ block.settings.title }}
            </h3>

            <div class="pl-cnt">
              {{ products.size }} products
            </div>

            {%- if block.settings.description != blank -%}
              <p class="pl-inc">
                {{ block.settings.description }}
              </p>
            {%- endif -%}

            <div class="pl-prow">

              <strong>
                {{ block.settings.bundle_price | money }}
              </strong>

              {%- if compare_total > block.settings.bundle_price -%}

                <s>
                  {{ compare_total | money }}
                </s>

                <em>
                  Save {{ savings | money }}
                </em>

              {%- endif -%}

            </div>

            <div class="pl-fine">
              Inclusive of all taxes · COD available
            </div>

            <a
              class="pl-btn {% if block.settings.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}"
              href="{{ block.settings.link | default: '#' }}"
            >
              Shop bundle

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>

            </a>

          </div>

        </article>

      {%- endfor -%}

    </div>

    <div class="pl-swipecue" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>

      Swipe for more combos
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="pl-railnote">
        {{ section.settings.footnote }}
      </p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "pl-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo name",
          "default": "Kitchen essentials"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in this combo",
          "limit": 3,
          "info": "Pick up to 3. Prices, images and titles come straight from these products."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Bundle price",
          "info": "The flat price charged for the combo. Compare-at and savings are calculated automatically from the products above.",
          "default": 499
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Corner flag (optional)",
          "info": "e.g. Most popular"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight as featured combo",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Shop bundle link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}